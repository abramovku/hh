APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_EXTERNAL_URL=https://yourapp.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------
#   HH service
# ----------------------
HH_API_URL=https://api.hh.ru/
HH_API_AUTH_URL=https://hh.ru/oauth/authorize
HH_CLIENT_ID=YOUR_HH_CLIENT_ID
HH_CLIENT_SECRET=YOUR_HH_CLIENT_SECRET
HH_REDIRECT_URI=${APP_URL}/hh-callback
HH_EMPLOYER=1234567

# ----------------------
#   Estaff service
# ----------------------
ESTAFF_API_URL=https://estaff.example.com/api/
ESTAFF_TOKEN=YOUR_ESTAFF_API_TOKEN

# ----------------------
#   Twin service
# ----------------------
TWIN_AUTH_URL=https://iam.twin24.ai/api/v1/
TWIN_AUTH_EMAIL=your@email.com
TWIN_AUTH_PASSWORD=your_twin_password
TWIN_CHAT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TWIN_BOT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TWIN_COLD_BOT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TWIN_PROVIDER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TWIN_DEFAULT_EXEC=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TWIN_CID=79001234567
TWIN_SMS_TEXT=Текст SMS-сообщения
TWIN_SMS_FROM=GloriaJeans
TWIN_CALL_TYPE=Продавец-Кассир РФ
TWIN_ALLOWED_TIME_FROM=9:00:00
TWIN_ALLOWED_TIME_TO=22:00:00
TWIN_ALLOW_CALL_TIME_FROM=32400
TWIN_ALLOW_CALL_TIME_TO=79200

# ----------------------
#   New call flow (ТЗ «ПК — обзвон»). legacy | new | hybrid
#   hybrid = legacy for everyone except Estaff vacancies listed in FLOW_NEW_VACANCY_IDS
# ----------------------
FLOW_MODE=legacy
FLOW_NEW_VACANCY_IDS=
FLOW_TIMEZONE=Europe/Moscow
# Comma-separated Estaff vacancy position_id values allowed for processing (3.1)
ESTAFF_ALLOWED_POSITION_IDS=
# Vacancies that use the "old script" bot (4.5)
FLOW_OLD_SCRIPT_VACANCY_IDS=7541291626956944847
TWIN_BOT_WARM=031e44f5-76b6-4442-a109-09e0654582ea
TWIN_BOT_COLD=093f6415-58f8-4bb5-ac93-0bfb4389f23e
TWIN_BOT_OLD=e227cd98-266a-4218-bd07-45a125e814d9
TWIN_BOT_REMINDER=eb314aa3-ceb5-4146-abc0-f4daf14332a6
TWIN_BOT_FEEDBACK=3d4c8b21-6924-424b-8430-0cf1aa14de6e
TWIN_AUTOCALL_URL=https://cis.twin24.ai/api/v1/telephony/autoCall
TWIN_AUTOCALL_CANDIDATE_URL=https://cis.twin24.ai/api/v1/telephony/autoCallCandidate
TWIN_ANALYSE_URL=https://analyse.twin24.ai/api/v1/search/cis/sessions
FLOW_SLEEP_AFTER_CREATE=6
FLOW_ANALYSE_RETRY_DELAY=60
FLOW_ANALYSE_MAX_ATTEMPTS=3
FLOW_ESTAFF_STATE_FIELD=state_id
# Interview date is read from candidate events[]; Estaff state_date is only the transition date. Leave empty.
FLOW_ESTAFF_STATE_DATE_FIELD=

# ----------------------
#   Telegram service
# ----------------------
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890

# ----------------------
#   Location service (region by phone)
# ----------------------
LOCATION_API_URL=
LOCATION_API_TIMEOUT=5
LOCATION_API_RETRIES=1
LOCATION_API_VERIFY_SSL=false

# ----------------------
#   Monitor service
# ----------------------
FAILED_JOBS_LIMIT=5
FAILED_JOBS_NOTIFY_COOLDOWN=3600
